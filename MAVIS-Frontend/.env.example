# Server configuration. Never put API credentials in NEXT_PUBLIC_* variables.
# Default development mode is explicitly labeled sample data.
MAVIS_API_MODE=mock
MAVIS_MOCK_SCENARIO=normal

# Backend mode: configure only after agreeing the response/request mappings.
# This origin and operation mapping are private server settings.
# MAVIS_BACKEND_URL=
# MAVIS_API_OPERATIONS={}
# Comma-separated names of backend-owned session cookies to forward.
# MAVIS_SESSION_COOKIES=
