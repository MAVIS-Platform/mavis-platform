# Server-only configuration. Keep credentials out of NEXT_PUBLIC_*.
# Use mock only for labeled sample previews. Backend mode uses explicit Java translators.
MAVIS_API_MODE=backend
MAVIS_JAVA_URL=http://127.0.0.1:8081
MAVIS_MOCK_SCENARIO=normal
