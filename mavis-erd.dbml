// ============================================================================
// MAVIS - Database ERD (DBML)
// File nay de import vao dbdiagram.io de ve so do quan he
// Link: https://dbdiagram.io/d
//
// Tai khoan chinh: UUID cho moi bang, RBAC chuan, Pattern Immutable Analysis
// ============================================================================

// =========================
// DOMAIN: PLATFORM
// =========================

Table users {
  id uuid [pk, default: `uuid_generate_v4()`]
  email varchar(255) [unique, not null, note: 'Dung de dang nhap']
  password_hash varchar(255) [not null, note: 'bcrypt/argon2']
  full_name varchar(255)
  status varchar(20) [not null, default: 'ACTIVE', note: 'ACTIVE / LOCKED']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Tai khoan nguoi dung (Developer + Admin, phan biet qua roles)'
}

Table roles {
  id uuid [pk, default: `uuid_generate_v4()`]
  code varchar(50) [unique, not null, note: 'ADMIN / DEVELOPER / SUPPORT_STAFF']
  description text

  Note: 'Vai tro trong he thong'
}

Table permissions {
  id uuid [pk, default: `uuid_generate_v4()`]
  code varchar(100) [unique, not null, note: 'PROJECT_DELETE / USER_LOCK']
  description text

  Note: 'Quyen han cu the'
}

Table user_roles {
  user_id uuid [pk, not null, ref: > users.id]
  role_id uuid [pk, not null, ref: > roles.id]

  Note: 'Bang noi many-to-many: User <-> Role'
}

Table role_permissions {
  role_id uuid [pk, not null, ref: > roles.id]
  permission_id uuid [pk, not null, ref: > permissions.id]

  Note: 'Bang noi many-to-many: Role <-> Permission'
}

Table subscription_plans {
  id uuid [pk, default: `uuid_generate_v4()`]
  name varchar(100) [not null]
  max_projects int [not null]
  ai_explanation_credits int [not null]
  price numeric(12,2) [not null]
  billing_cycle varchar(20) [not null, note: 'MONTHLY / YEARLY']
  is_active boolean [not null, default: true]

  Note: 'Cac goi cuoc (Free, Premium...) do Admin cau hinh'
}

Table user_subscriptions {
  id uuid [pk, default: `uuid_generate_v4()`]
  user_id uuid [not null, ref: > users.id]
  plan_id uuid [not null, ref: > subscription_plans.id]
  status varchar(20) [not null, note: 'ACTIVE / EXPIRED / CANCELLED']
  ai_credits_remaining int [not null, default: 0, note: 'WARNING: can race condition']
  started_at timestamptz [not null, default: `now()`]
  expired_at timestamptz

  Note: 'Luot dang ky cua user, mot user co the co nhieu lich su'
}

Table payment_transactions {
  id uuid [pk, default: `uuid_generate_v4()`]
  user_subscription_id uuid [not null, ref: > user_subscriptions.id]
  amount numeric(12,2) [not null]
  currency varchar(10) [not null]
  gateway varchar(50) [not null, note: 'VNPay / Stripe / ...']
  gateway_transaction_id varchar(255) [note: 'Ma giao dich phia gateway']
  status varchar(20) [not null, note: 'PENDING / SUCCESS / FAILED']
  created_at timestamptz [not null, default: `now()`]

  Note: 'Moi lan goi Payment Gateway, 1 invoice co the co nhieu transaction'
}

Table billing_invoices {
  id uuid [pk, default: `uuid_generate_v4()`]
  user_subscription_id uuid [not null, ref: > user_subscriptions.id]
  amount numeric(12,2) [not null]
  issued_at timestamptz [not null, default: `now()`]
  due_at timestamptz
  status varchar(20) [not null, default: 'UNPAID', note: 'UNPAID / PAID / OVERDUE']

  Note: 'Hoa don phai thu'
}

Table system_configs {
  id uuid [pk, default: `uuid_generate_v4()`]
  config_key varchar(100) [unique, not null, note: 'AI_API_CREDENTIAL / PAYMENT_GATEWAY_CREDENTIAL']
  config_value jsonb [not null, note: 'Noi dung config, cau truc tuy loai']
  description text
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Config he thong, luu JSONB vi moi loai config khac nhau'
}

Table projects {
  id uuid [pk, default: `uuid_generate_v4()`]
  owner_id uuid [not null, ref: > users.id]
  name varchar(255) [not null]
  description text
  storage_path varchar(500) [not null, note: 'WARNING: can ro rang local vs S3']
  status varchar(20) [not null, default: 'ACTIVE', note: 'ACTIVE / DELETED (soft delete)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Project Developer import len, luu soft delete de giu lich su phan tich'
}

// =========================
// DOMAIN: ANALYZER (GRAPH CORE)
// =========================

Table analysis_sessions {
  id uuid [pk, default: `uuid_generate_v4()`]
  project_id uuid [not null, ref: > projects.id]
  triggered_by uuid [not null, ref: > users.id, note: 'Audit ai bam phan tich']
  status varchar(20) [not null, default: 'PENDING', note: 'PENDING / RUNNING / COMPLETED / FAILED']
  is_latest_valid boolean [not null, default: false, note: 'Partial unique index: 1 project chi co 1 true']
  error_message text
  started_at timestamptz [not null, default: `now()`]
  completed_at timestamptz

  Note: 'Trung tam cua pattern Immutable Analysis, moi lan re-analyze tao row moi'
}

Table service_nodes {
  id uuid [pk, default: `uuid_generate_v4()`]
  session_id uuid [not null, ref: > analysis_sessions.id]
  name varchar(255) [not null]
  node_type varchar(30) [not null, note: 'JAVA_SPRING / DOTNET / GENERIC']
  source_path varchar(500)
  metadata jsonb [note: 'Port, framework version... tuy loai']

  Note: 'Moi microservice detect duoc trong 1 session'
}

Table dependency_edges {
  id uuid [pk, default: `uuid_generate_v4()`]
  session_id uuid [not null, ref: > analysis_sessions.id]
  source_node_id uuid [not null, ref: > service_nodes.id]
  target_node_id uuid [not null, ref: > service_nodes.id]
  dependency_kind varchar(30) [not null, note: 'REST_HTTP / CONFIG_REF / DOCKER_LINK']
  description text

  Note: 'Canh phu thuoc giua 2 service'
}

Table evidence {
  id uuid [pk, default: `uuid_generate_v4()`]
  edge_id uuid [ref: > dependency_edges.id, note: 'NULL neu evidence thuoc node']
  node_id uuid [ref: > service_nodes.id, note: 'NULL neu evidence thuoc edge']
  file_path varchar(500) [not null]
  line_number int
  code_snippet text
  evidence_type varchar(30) [not null, note: 'HTTP_CALL / DOCKER_COMPOSE / CONFIG_VALUE']

  Note: 'Minh chung ma nguon, Developer click vao edge de xem code snippet'
}

Table impact_index {
  id uuid [pk, default: `uuid_generate_v4()`]
  session_id uuid [not null, ref: > analysis_sessions.id]
  source_node_id uuid [not null, ref: > service_nodes.id]
  affected_node_id uuid [not null, ref: > service_nodes.id]
  impact_type varchar(10) [not null, note: 'DIRECT / INDIRECT']
  hop_distance int [not null]
  path jsonb [note: 'Mang UUID: source -> ... -> affected']

  Note: 'Precompute Change Impact - phuc vu NFR < 3 giay (khong can BFS luc query)'
}

Table ai_explanations {
  id uuid [pk, default: `uuid_generate_v4()`]
  session_id uuid [not null, ref: > analysis_sessions.id]
  node_id uuid [ref: > service_nodes.id, note: 'NULL neu giai thich edge']
  edge_id uuid [ref: > dependency_edges.id, note: 'NULL neu giai thich node']
  requested_by uuid [not null, ref: > users.id]
  explanation_text text [not null]
  prompt_used text [note: 'Luu de audit khi AI tra loi sai']
  credit_cost int [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]

  Note: 'Lich su giai thich AI, tru credit tu user_subscriptions'
}

// =========================
// QUAN HE NGOAI (de hinh dung)
// =========================
// users            1---N user_subscriptions
// users            1---N user_roles   N---1 roles
// users            1---N projects
// users            1---N analysis_sessions (as triggered_by)
// users            1---N ai_explanations  (as requested_by)
// roles            1---N role_permissions N---1 permissions
// subscription_plans 1---N user_subscriptions
// user_subscriptions 1---N payment_transactions
// user_subscriptions 1---N billing_invoices
// projects         1---N analysis_sessions
// analysis_sessions 1---N service_nodes
// analysis_sessions 1---N dependency_edges
// analysis_sessions 1---N impact_index
// analysis_sessions 1---N ai_explanations
// service_nodes    1---N dependency_edges (as source)
// service_nodes    1---N dependency_edges (as target)
// service_nodes    1---N evidence
// service_nodes    1---N impact_index (as source)
// service_nodes    1---N impact_index (as affected)
// dependency_edges 1---N evidence
// dependency_edges 1---N ai_explanations
