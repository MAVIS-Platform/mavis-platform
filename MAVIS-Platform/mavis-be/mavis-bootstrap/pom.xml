<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>vn.edu.fpt</groupId>
    <artifactId>mavis-bootstrap</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>mavis-bootstrap</name>
    <description>mavis-bootstrap</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>21</java.version>
        <jackson-bom.version>2.22.4</jackson-bom.version>
        <postgresql.version>42.7.14</postgresql.version>
        <tomcat.version>10.1.62</tomcat.version>
        <log4j2.version>2.26.1</log4j2.version>
        <commons-lang3.version>3.19.0</commons-lang3.version>
        <guava.version>33.8.0-jre</guava.version>
    </properties>
    <dependencies>


        <!-- Thư viện JPA để nhận diện @EntityScan và @EnableJpaRepositories -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Đảm bảo Bootstrap đã liên kết với mavis-common (nếu chưa có) -->
        <dependency>
            <groupId>vn.edu.fpt</groupId>
            <artifactId>mavis-common</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>

        <!-- Liên kết với module mavis-platform -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>mavis-platform</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Liên kết với module mavis-analyzer -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>mavis-analyzer</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.mavis</groupId>
            <artifactId>worker-java-client</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
