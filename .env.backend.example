# Initialize by double-clicking run.bat
# Fill the real test database credentials supplied by the database owner.
MAVIS_DB_URL=jdbc:postgresql://<HOST>:<PORT>/defaultdb?sslmode=require
MAVIS_DB_USERNAME=<DB_USER>
MAVIS_DB_PASSWORD=<DB_PASSWORD>
# Shared DB schema updates are separately reviewed. The launcher honors explicit opt-in,
# but refuses duplicate Flyway versions; reconcile history before setting true.
MAVIS_DB_MIGRATIONS_ENABLED=false
# Initialize generates stable local keys for these values.
MAVIS_JWT_SECRET=<GENERATED_BY_INITIALIZE>
MAVIS_RUNNER_SERVICE_KEY=<GENERATED_BY_INITIALIZE>
MAVIS_WORKER_SERVICE_KEY=<GENERATED_BY_INITIALIZE>
MAVIS_WORKER_GRANT_KEY=<GENERATED_BY_INITIALIZE>
MAVIS_WORKER_GRANT_KEY_ID=local
MAVIS_JAVA_PORT=8081
MAVIS_WORKER_PORT=5082
MAVIS_FE_PORT=3000
# Optional machine-local toolchain paths, used by run.bat without changing global PATH.
# MAVIS_JAVA_HOME=C:\Program Files\Java\jdk-21
# MAVIS_DOTNET_ROOT=C:\path\to\dotnet-10.0.204
# Optional existing .NET CLI/package caches; otherwise dotnet uses its defaults.
# DOTNET_CLI_HOME=C:\path\to\dotnet-home
# NUGET_PACKAGES=C:\path\to\nuget-packages
# Optional real SMTP configuration, required to deliver registration/reset OTP mail.
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=                 # Defaults to MAIL_USERNAME; Gmail must use its App Password.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS_ENABLE=true
# Local SMTP capture only: host=127.0.0.1, port=1025, auth=false, STARTTLS=false.
# MAIL_FROM=mavis-local@example.invalid
# MAVIS_DB_MAX_POOL_SIZE=4   # Keep room for teammates/DBeaver on a 20-connection service.

# Google OAuth web client ID; must match Java app.google.client-id and authorized browser origin.
# MAVIS_GOOGLE_CLIENT_ID=

# Optional AI usage telemetry and OpenAI project quota (server secrets, never commit values).
# Set the same random 32+ character key on backend and Next server for telemetry ingest.
# MAVIS_AI_USAGE_INGEST_KEY=
# OPENAI_ADMIN_KEY=
# OPENAI_PROJECT_ID=
# Optional Gemini Cloud Monitoring quota; mount the auto-refreshed OAuth token file read-only.
# MAVIS_GCP_PROJECT_ID=
# MAVIS_GEMINI_QUOTA_TIER=
# MAVIS_GCP_MONITORING_TOKEN_FILE=
